# Copy to .env and fill in. Never commit .env. In production, set these as secrets in your host's settings.

# Postgres owner role (migrations, ingest jobs). Any long random string.
POSTGRES_PASSWORD=
# Restricted role the web app uses (row-level security applies). Any long random string.
APP_DB_PASSWORD=

# Demo seed (SEED_DEMO=0 to skip). Leave passwords blank to have random ones printed once by the init service.
SEED_DEMO=1
SEED_TEAM_EMAIL=team@nazryx.test
SEED_TEAM_PASSWORD=
DEMO_PASSWORD=

# Team alerts (48-hour registry reminder, new requests, claims). Email and WhatsApp are stubbed by default.
TEAM_ALERT_EMAILS=
TEAM_ALERT_WHATSAPP=
EMAIL_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@nazryx.com

# Optional: Claude API for molecule-match suggestions in the admin review queue.
ANTHROPIC_API_KEY=

# Optional: error monitoring (Sentry). Empty = off.
SENTRY_DSN=

# Web
WEB_PORT=3000
SUPPORT_EMAIL=contact@nazryx.com
SUPPORT_WHATSAPP=
# Team accounts must turn on two-step sign-in before Admin opens. Set to 0 only for local testing.
TEAM_2FA_REQUIRED=1
# Set to 1 only when serving over plain http on a host other than localhost (session cookie without Secure).
INSECURE_COOKIES=0
